# FinSight Environment Configuration
# Copy to .env and fill in values

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Alternative model (has fine-tuned RLM version available)
# OLLAMA_MODEL=qwen3:8b-q4_K_M

# API Keys (all free tiers)
FRED_API_KEY=           # https://fred.stlouisfed.org/docs/api/api_key.html
FINNHUB_API_KEY=        # https://finnhub.io/register
FMP_API_KEY=            # https://site.financialmodelingprep.com/developer

# SEC EDGAR (no key needed, just identify yourself)
SEC_USER_AGENT=FinSight research@example.com

# Data Paths
DATA_DIR=./data
FILINGS_DIR=./data/filings
TREES_DIR=./data/trees

# PageIndex Configuration
PAGEINDEX_MODEL=gpt-4o-2024-11-20
# For local PageIndex tree generation, you need an OpenAI key OR
# configure PageIndex to use Ollama (experimental)
OPENAI_API_KEY=         # Only needed for PageIndex tree generation
